# --- Backend only (never expose these to the browser) ---

# Restricted to the Directions API (and Geocoding, if used). Called from server/api/directions.post.ts.
GOOGLE_MAPS_API_KEY=

# Fixed company location used as the directions destination.
COMPANY_LAT=13.805384
COMPANY_LNG=100.537707

# Frontend origin allowed to call this API when it is deployed separately from the frontend
# (e.g. backend on Render, frontend on Vercel). Leave empty for same-origin/full-stack deployments.
CORS_ORIGIN=

# --- Frontend (public, exposed to the browser) ---

# Restricted to the Maps JavaScript API by HTTP referrer in Google Cloud Console.
NUXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# Base URL of the backend API. Leave empty when frontend and backend are the same Nuxt deployment.
NUXT_PUBLIC_API_BASE_URL=
