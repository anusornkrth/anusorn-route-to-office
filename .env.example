# Server-only key used to call the Directions API from server/api/directions.post.ts.
# Never expose this one to the browser. Restrict it to the Directions API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Browser key used to render the Maps JavaScript API on the frontend.
# This one is meant to be public; restrict it by HTTP referrer in Google Cloud Console.
NUXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
